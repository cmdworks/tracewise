# direnv (run `direnv allow` once): puts .devbin on PATH inside this checkout, so `twd` (build and link the dev build into
# ~/.local/bin) and `twdev` (run it on separate data) work before anything is installed.
mkdir -p .devbin
ln -sf ../scripts/twd .devbin/twd
ln -sf ../scripts/twdev .devbin/twdev
rm -rf .devbin/shadow .devbin/tracewise
PATH_add .devbin
